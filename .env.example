# ── Required ────────────────────────────────────────────────────────────────
# Gonka network node to scrape (host:port serving /v1/mlnodes/metrics).
# Use your own network node, or any node that exposes the endpoint.
GONKA_NODE=your-node.example.com:8000
GONKA_SCHEME=http          # http or https (https ⇒ use :443 in GONKA_NODE)

# ── Optional ────────────────────────────────────────────────────────────────
RETENTION=90d              # how long VictoriaMetrics keeps data
GRAFANA_PORT=3000          # host port for the Grafana UI
ADMIN_PASSWORD=admin       # CHANGE before exposing this anywhere public

# ── PoC / cPoC phase shading (optional) ─────────────────────────────────────
# Enable with:  docker compose --profile phases up -d
GONKA_RPC=tcp://your-node:26657                          # your node's Tendermint RPC
INFERENCED_IMAGE=ghcr.io/product-science/inferenced:0.2.15
POLL_INTERVAL=30
