# ── Required ────────────────────────────────────────────────────────────────
# Your Gonka network node. Both are needed: the RPC discovers the active epoch
# participants (whole network); the HTTP API resolves them to scrape URLs.
GONKA_RPC=tcp://your-node:26657          # Tendermint RPC of your node
GONKA_NODE=your-node.example.com:8000    # host:port serving /v1/participants
GONKA_SCHEME=http                        # http or https for GONKA_NODE

# ── Optional ────────────────────────────────────────────────────────────────
INFERENCED_IMAGE=ghcr.io/product-science/inferenced:0.2.15   # node image (has inferenced)
DISCOVERY_INTERVAL=60      # seconds between epoch re-discovery runs
RETENTION=90d              # how long VictoriaMetrics keeps data
GRAFANA_PORT=3000          # host port for the UI
ADMIN_PASSWORD=admin       # CHANGE before exposing this anywhere public

# ── PoC / cPoC phase shading (optional) ─────────────────────────────────────
# Enable with:  docker compose --profile phases up -d
POLL_INTERVAL=30
