    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "expr": "sum(rate(vllm:request_queue_time_seconds_sum{node_id=~\"$node_id\"}[10m])) / sum(rate(vllm:request_queue_time_seconds_count{node_id=~\"$node_id\"}[10m]))",
     "legendFormat": "queue mean",
     "refId": "A"
    },
    {
     "expr": "sum(rate(vllm:time_to_first_token_seconds_sum{node_id=~\"$node_id\"}[10m])) / sum(rate(vllm:time_to_first_token_seconds_count{node_id=~\"$node_id\"}[10m]))",
     "legendFormat": "ttft mean",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Inter-token latency p95 (10m)",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
