    }
   ]
  },
  {
   "type": "row",
   "title": "Latency & throughput",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 15
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Requests by replica",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "expr": "sum by (replica) (vllm:num_requests_running{node_id=~\"$node_id\"})",
     "legendFormat": "running r{{replica}}",
     "refId": "A"
    },
    {
     "expr": "sum by (replica) (vllm:num_requests_waiting{node_id=~\"$node_id\"})",
     "legendFormat": "waiting r{{replica}}",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "TTFT quantiles (10m)",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     },
     "unit": "s",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket{node_id=~\"$node_id\"}[10m])))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket{node_id=~\"$node_id\"}[10m])))",
     "legendFormat": "p95",
     "refId": "B"
    },
    {
     "expr": "histogram_quantile(0.99, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket{node_id=~\"$node_id\"}[10m])))",
     "legendFormat": "p99",
     "refId": "C"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Queue vs compute share of TTFT (mean, 10m)",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     },
     "unit": "s",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
