     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Tokens /s",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 32
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "expr": "sum(rate(vllm:prompt_tokens_total{node_id=~\"$node_id\"}[5m]))",
     "legendFormat": "prompt",
     "refId": "A"
