{
 "uid": "gonka-node",
 "title": "Gonka ML node",
 "timezone": "utc",
 "schemaVersion": 39,
 "version": 2,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "node_id",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "vm"
    },
    "query": {
     "query": "label_values(mlnode_up, node_id)",
     "refId": "n"
    },
    "refresh": 2,
    "sort": 1,
    "multi": true,
    "includeAll": true,
    "current": {},
    "definition": "label_values(mlnode_up, node_id)"
   }
  ]
 },
 "panels": [
  {
   "type": "table",
   "title": "Node info (version / model / config)",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "h": 5,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "instant": true,
     "format": "table",
     "expr": "max by (node_id,version)(mlnode_version_info{node_id=~\"$node_id\"})"
    },
    {
     "refId": "B",
     "instant": true,
     "format": "table",
     "expr": "max by (node_id,model_name,tensor_parallel_size,max_model_len,max_num_seqs,dtype,replicas)(mlnode_config_info{node_id=~\"$node_id\"})"
    }
   ],
   "transformations": [
    {
     "id": "joinByField",
     "options": {
      "byField": "node_id",
      "mode": "outer"
     }
    },
    {
     "id": "organize",
     "options": {
      "renameByName": {
       "node_id": "mlnode",
       "version": "version",
       "model_name": "model",
       "tensor_parallel_size": "TP",
       "max_model_len": "max len",
       "max_num_seqs": "max seqs",
       "replicas": "replicas",
       "dtype": "dtype"
      },
      "excludeByName": {
       "Time": true,
       "Time 1": true,
       "Time 2": true,
       "Value #A": true,
       "Value #B": true,
       "wallet": true,
       "moniker": true,
       "weight": true,
       "job": true,
       "instance": true,
       "__name__": true,
       "pipeline_parallel_size": true
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "center",
      "filterable": false
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "mlnode"
      },
      "properties": [
       {
        "id": "custom.align",
        "value": "left"
       },
       {
        "id": "custom.width",
        "value": 180
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "model"
      },
      "properties": [
       {
        "id": "custom.align",
        "value": "left"
       },
       {
        "id": "custom.width",
        "value": 280
       }
      ]
     }
    ]
   }
  },
  {
   "type": "stat",
   "title": "Requests processed (selected range)",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "description": "",
   "gridPos": {
    "h": 5,
    "w": 8,
    "x": 0,
    "y": 5
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value",
    "justifyMode": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "locale",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(increase(vllm:request_success_total{node_id=~\"$node_id\"}[$__range]))",
     "refId": "A",
     "instant": true
    }
   ]
  },
  {
   "type": "stat",
   "title": "Input tokens (selected range)",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "description": "",
   "gridPos": {
    "h": 5,
    "w": 8,
    "x": 8,
    "y": 5
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value",
    "justifyMode": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "locale",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(increase(vllm:prompt_tokens_total{node_id=~\"$node_id\"}[$__range]))",
     "refId": "A",
     "instant": true
    }
   ]
  },
  {
   "type": "stat",
   "title": "Output tokens (selected range)",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "description": "",
   "gridPos": {
    "h": 5,
    "w": 8,
    "x": 16,
    "y": 5
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value",
    "justifyMode": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "locale",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(increase(vllm:generation_tokens_total{node_id=~\"$node_id\"}[$__range]))",
     "refId": "A",
     "instant": true
    }
   ]
  },
  {
   "type": "row",
   "title": "Inference status",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 10
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Reachable",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 0,
    "y": 11
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "no",
         "index": 0
        },
        "1": {
         "text": "yes",
         "index": 1
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "mlnode_up{node_id=~\"$node_id\"}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Running",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 3,
    "y": 11
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(vllm:num_requests_running{node_id=~\"$node_id\"})",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Waiting",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 6,
    "y": 11
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(vllm:num_requests_waiting{node_id=~\"$node_id\"})",
     "refId": "A"
    }
   ]
  },
  {
   "type": "gauge",
   "title": "KV cache",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 9,
    "y": 11
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "showThresholdMarkers": true
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.8
       },
       {
        "color": "red",
        "value": 0.95
       }
      ]
     },
     "max": 1,
     "min": 0,
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "max(vllm:kv_cache_usage_perc{node_id=~\"$node_id\"})",
     "refId": "A"
    }
   ],
   "description": "Share of the KV cache in use (context memory). Near 1.0 = the node is close to its context capacity."
  },
  {
   "type": "stat",
   "title": "Preemptions /min",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 12,
    "y": 11
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(vllm:num_preemptions_total{node_id=~\"$node_id\"}[10m])) * 60",
     "refId": "A"
    }
   ]
  },
  {
   "type": "gauge",
   "title": "Prefix-cache hit",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 15,
    "y": 11
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "showThresholdMarkers": true
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 2,
     "max": 1,
     "min": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.3
       },
       {
        "color": "green",
        "value": 0.6
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(vllm:prefix_cache_hits_total{node_id=~\"$node_id\"}[30m])) / sum(rate(vllm:prefix_cache_queries_total{node_id=~\"$node_id\"}[30m]))",
     "refId": "A"
    }
   ],
   "description": "Fraction of prompt tokens served from cache instead of recomputed. Higher = cheaper repeated prompts."
  },
  {
   "type": "stat",
   "title": "vLLM data age",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 18,
    "y": 11
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 120
       },
       {
        "color": "red",
        "value": 600
       }
      ]
