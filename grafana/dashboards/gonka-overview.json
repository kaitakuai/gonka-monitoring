{
 "uid": "gonka-overview",
 "title": "Gonka network overview",
 "schemaVersion": 39,
 "editable": true,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "tags": [
  "gonka"
 ],
 "links": [
  {
   "title": "Gonka dashboards",
   "type": "dashboards",
   "tags": [
    "gonka"
   ],
   "asDropdown": true,
   "includeVars": true,
   "keepTime": true,
   "icon": "apps",
   "targetBlank": false
  }
 ],
 "templating": {
  "list": []
 },
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "name": "Annotations & Alerts",
    "type": "dashboard",
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)"
   },
   {
    "name": "PoC",
    "type": "tags",
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "iconColor": "orange",
    "tags": [
     "poc"
    ]
   },
   {
    "name": "cPoC",
    "type": "tags",
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "iconColor": "purple",
    "tags": [
     "cpoc"
    ]
   }
  ]
 },
 "panels": [
  {
   "type": "stat",
   "title": "Network nodes",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "description": "Network nodes active in the current epoch (auto-discovered and scraped).",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 0,
    "y": 0
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value",
    "justifyMode": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "count(up{job=\"gonka-epoch\"})",
     "refId": "A",
     "instant": true
    }
   ]
  },
  {
   "type": "stat",
   "title": "Online",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "description": "Of those, how many answered their metrics endpoint on the last scrape.",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 6,
    "y": 0
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value",
    "justifyMode": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "green"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(up{job=\"gonka-epoch\"})",
     "refId": "A",
     "instant": true
    }
   ]
  },
  {
   "type": "stat",
   "title": "Network nodes with live ML nodes",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "description": "Network nodes that currently have at least one ML node serving metrics.",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 12,
    "y": 0
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value",
    "justifyMode": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "count(count by(wallet)(mlnode_up{job=\"gonka-epoch\"} == 1))",
     "refId": "A",
     "instant": true
    }
   ]
  },
  {
   "type": "stat",
   "title": "Live ML nodes",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "description": "Total ML nodes up right now across the whole network.",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 18,
    "y": 0
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value",
    "justifyMode": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "count(mlnode_up{job=\"gonka-epoch\"} == 1)",
     "refId": "A",
     "instant": true
    }
   ]
  },
  {
   "type": "stat",
   "title": "Requests",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "description": "Inference requests finished by all monitored ML nodes over the selected time range.",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 0,
    "y": 5
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value",
    "justifyMode": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "locale",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(increase(vllm:request_success_total{job=\"gonka-epoch\"}[$__range]))",
     "refId": "A",
     "instant": true
    }
   ]
  },
  {
   "type": "stat",
   "title": "Input tokens",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "description": "Prompt tokens processed over the selected range. This is real engine work \u2014 it includes validation re-runs, so it is higher than the chain's billed-inference figure.",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 6,
    "y": 5
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value",
    "justifyMode": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "locale",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(increase(vllm:prompt_tokens_total{job=\"gonka-epoch\"}[$__range]))",
     "refId": "A",
     "instant": true
    }
   ]
  },
  {
   "type": "stat",
   "title": "Output tokens",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "description": "Tokens generated over the selected range.",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 12,
    "y": 5
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value",
    "justifyMode": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "locale",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(increase(vllm:generation_tokens_total{job=\"gonka-epoch\"}[$__range]))",
     "refId": "A",
     "instant": true
    }
   ]
  },
  {
   "type": "stat",
   "title": "Tokens/sec now",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "description": "Current generation throughput across the whole network (5-minute rate).",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 18,
    "y": 5
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value",
    "justifyMode": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "green"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(vllm:generation_tokens_total{job=\"gonka-epoch\"}[5m]))",
     "refId": "A",
     "instant": true
    }
   ]
  },
  {
   "type": "table",
   "title": "Network nodes \u2014 click a row to open the wallet",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "h": 42,
    "w": 24,
    "x": 0,
    "y": 10
   },
   "options": {
    "showHeader": true,
    "sortBy": [
     {
      "displayName": "weight",
      "desc": true
     }
    ]
   },
   "targets": [
    {
     "refId": "A",
     "instant": true,
     "format": "table",
     "expr": "up{job=\"gonka-epoch\"}"
    },
    {
     "refId": "W",
     "instant": true,
     "format": "table",
     "expr": "gonka_wallet_weight"
    },
    {
     "refId": "B",
     "instant": true,
     "format": "table",
     "expr": "count by(wallet)(mlnode_up{job=\"gonka-epoch\"})"
    },
    {
     "refId": "C",
     "instant": true,
     "format": "table",
     "expr": "count by(wallet)(mlnode_up{job=\"gonka-epoch\"} == 1)"
    },
    {
     "refId": "D",
     "instant": true,
     "format": "table",
     "expr": "sum by(wallet)(increase(vllm:request_success_total{job=\"gonka-epoch\"}[$__range]))"
    },
    {
     "refId": "E",
     "instant": true,
     "format": "table",
     "expr": "sum by(wallet)(increase(vllm:prompt_tokens_total{job=\"gonka-epoch\"}[$__range]))"
    },
    {
     "refId": "F",
     "instant": true,
     "format": "table",
     "expr": "sum by(wallet)(increase(vllm:generation_tokens_total{job=\"gonka-epoch\"}[$__range]))"
    },
    {
     "refId": "G",
     "instant": true,
     "format": "table",
     "expr": "sum by(wallet)(rate(vllm:generation_tokens_total{job=\"gonka-epoch\"}[5m]))"
    },
    {
     "refId": "H",
     "instant": true,
     "format": "table",
     "expr": "(sum by(wallet)(rate(vllm:request_success_total{job=\"gonka-epoch\"}[10m])) > bool 0) + 1"
    }
   ],
   "transformations": [
    {
     "id": "joinByField",
     "options": {
      "byField": "wallet",
      "mode": "outer"
     }
    },
    {
     "id": "organize",
     "options": {
      "renameByName": {
       "moniker": "node",
       "Value #W": "weight",
       "wallet": "wallet",
       "Value #A": "reachable",
       "Value #H": "status",
       "Value #B": "nodes",
       "Value #C": "up",
       "Value #D": "requests",
       "Value #E": "in tokens",
       "Value #F": "out tokens",
       "Value #G": "tok/s"
      },
      "excludeByName": {
       "Time": true,
       "job": true,
       "instance": true,
       "__name__": true
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "fields": "",
      "sort": [
       {
        "field": "weight",
        "desc": true
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "center",
      "filterable": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "node"
      },
      "properties": [
       {
        "id": "custom.align",
        "value": "left"
       },
       {
        "id": "custom.width",
        "value": 160
       },
       {
        "id": "links",
        "value": [
         {
          "title": "open wallet",
          "url": "/d/gonka-network/gonka-network-node-wallet?var-wallet=${__data.fields.wallet}"
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "wallet"
      },
      "properties": [
       {
        "id": "custom.hidden",
        "value": true
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "status"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 110
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background",
         "mode": "basic"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "yellow",
           "value": null
          },
          {
           "color": "green",
           "value": 2
          }
         ]
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "1": {
            "text": "idle",
            "index": 0
           },
           "2": {
            "text": "serving",
            "index": 1
           }
          }
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "weight"
      },
      "properties": [
       {
        "id": "unit",
        "value": "short"
       },
       {
        "id": "decimals",
        "value": 0
       },
       {
        "id": "custom.width",
        "value": 90
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "reachable"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 100
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background",
         "mode": "basic"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "red",
           "value": null
          },
          {
           "color": "green",
           "value": 1
          }
         ]
        }
       },
       {
        "id": "custom.displayMode",
        "value": "color-background"
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "0": {
            "text": "no",
            "index": 0
           },
           "1": {
            "text": "yes",
            "index": 1
           }
          }
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "nodes"
      },
      "properties": [
       {
        "id": "decimals",
        "value": 0
       },
       {
        "id": "custom.width",
        "value": 90
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "up"
      },
      "properties": [
       {
        "id": "decimals",
        "value": 0
       },
       {
        "id": "custom.width",
        "value": 90
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "requests"
      },
      "properties": [
       {
        "id": "unit",
        "value": "locale"
       },
       {
        "id": "decimals",
        "value": 0
       },
       {
        "id": "custom.width",
        "value": 125
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "in tokens"
      },
      "properties": [
       {
        "id": "unit",
        "value": "locale"
       },
       {
        "id": "decimals",
        "value": 0
       },
       {
        "id": "custom.width",
        "value": 135
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "out tokens"
      },
      "properties": [
       {
        "id": "unit",
        "value": "locale"
       },
       {
        "id": "decimals",
        "value": 0
       },
       {
        "id": "custom.width",
        "value": 135
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "tok/s"
      },
      "properties": [
       {
        "id": "unit",
        "value": "short"
       },
       {
        "id": "decimals",
